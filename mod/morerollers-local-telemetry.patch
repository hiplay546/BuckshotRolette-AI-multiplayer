diff --git a/src/pack/mods/splitscreen/command_bridge.gd b/src/pack/mods/splitscreen/command_bridge.gd
new file mode 100644
index 0000000..884f80a
--- /dev/null
+++ b/src/pack/mods/splitscreen/command_bridge.gd
@@ -0,0 +1,256 @@
+extends Node
+## Local manual command interface for all four views. Every action uses the game's request path.
+
+var elapsed := 0.0
+var seen_ids := {}
+var aimed_sockets := {}
+var last_active_sockets := {}
+
+func _ready() -> void:
+	SplitMod.telemetry_event.connect(_on_telemetry_event)
+
+func _on_telemetry_event(event_type: String, data: Dictionary) -> void:
+	if event_type == "aim_changed":
+		aimed_sockets[int(data.get("shooter_socket", -1))] = int(data.get("target_socket", -1))
+
+func _process(delta: float) -> void:
+	elapsed += delta
+	if elapsed < 0.2:
+		return
+	elapsed = 0.0
+	var session = get_parent()
+	if !SplitMod.active or !session.started or session.views.is_empty():
+		return
+	var directory := ProjectSettings.globalize_path("user://modbucksot")
+	DirAccess.make_dir_recursive_absolute(directory)
+	for index in range(session.views.size()):
+		_process_view(session.views[index], index + 1, directory)
+
+func _process_view(view: Dictionary, player_number: int, directory: String) -> void:
+	if view.vp.get_child_count() == 0:
+		return
+	var root = view.vp.get_child(0)
+	var inter = root.get_node_or_null("standalone managers/interactions/interaction intermediary")
+	if inter == null or inter.intermed_properties == null:
+		return
+	var player = inter.intermed_properties
+	_auto_distribute_items(inter, player, player_number)
+	var active_socket: int = inter.game_state.MAIN_active_current_turn_socket
+	if active_socket != int(last_active_sockets.get(player_number, -1)):
+		aimed_sockets.erase(player.socket_number)
+		last_active_sockets[player_number] = active_socket
+	var aimed_socket: int = int(aimed_sockets.get(player.socket_number, -1))
+	var visible_players := []
+	for participant in inter.instance_handler.instance_property_array:
+		visible_players.append({"socket": participant.socket_number, "name": participant.user_name, "health": participant.health_current, "is_jammed": participant.is_jammed})
+	var visible_items := []
+	for slot_index in range(player.user_inventory_instance_array.size()):
+		var item = player.user_inventory_instance_array[slot_index]
+		if item != null and item.get_child_count() > 1:
+			var branch = item.get_child(1)
+			visible_items.append({"slot": slot_index + 1, "item_id": branch.item_id, "name": branch.itemName, "usable": _can_use_item(inter, player) and branch.interactionAllowed and !branch.interactionInvalid, "needs_second_choice": branch.has_secondary_interaction})
+	var stealable_items := []
+	if player.is_stealing_item:
+		for participant in inter.instance_handler.instance_property_array:
+			if participant.socket_number == player.socket_number or participant.health_current <= 0:
+				continue
+			for slot_index in range(participant.user_inventory_instance_array.size()):
+				var item = participant.user_inventory_instance_array[slot_index]
+				if item != null and item.get_child_count() > 1:
+					var branch = item.get_child(1)
+					stealable_items.append({"socket": participant.socket_number, "slot": slot_index + 1, "item_id": branch.item_id, "name": branch.itemName, "usable": branch.item_id != 8 and branch.interactionAllowed and !branch.interactionInvalid})
+	_write_json(directory.path_join("control-state-player-%d.json" % player_number), {
+		"updated_utc": Time.get_datetime_string_from_system(true, true),
+		"match_id": SplitMod.telemetry_match_id,
+		"event_id": SplitMod.telemetry_event_id,
+		"player_number": player_number,
+		"player_socket": player.socket_number,
+		"active_socket": active_socket,
+		"has_turn": player.has_turn,
+		"holding_shotgun": player.is_holding_shotgun,
+		"aimed_socket": aimed_socket,
+		"can_pickup": _can_pickup(inter, player),
+		"can_use_item": _can_use_item(inter, player),
+		"can_aim": _can_aim(inter, player),
+		"can_shoot": _can_aim(inter, player) and aimed_socket >= 0,
+		"timeouts_enabled": GlobalVariables.timeouts_enabled,
+		"secondary_choice": "jammer_target" if player.is_viewing_jammer else ("steal_item" if player.is_stealing_item else ""),
+		"players": visible_players,
+		"items": visible_items,
+		"stealable_items": stealable_items,
+	})
+	var command_path := directory.path_join("control-command-player-%d.json" % player_number)
+	if !FileAccess.file_exists(command_path):
+		return
+	var parsed = JSON.parse_string(FileAccess.get_file_as_string(command_path))
+	if !(parsed is Dictionary):
+		return
+	var command: Dictionary = parsed
+	var command_id = command.get("command_id", "")
+	if !(command_id is String) or command_id.is_empty() or seen_ids.has(command_id):
+		return
+	seen_ids[command_id] = true
+	var result := _execute(command, inter, player, player_number)
+	var response := {
+		"command_id": command_id,
+		"match_id": SplitMod.telemetry_match_id,
+		"player_number": player_number,
+		"accepted": result == "request_sent",
+		"status": result,
+		"timestamp_utc": Time.get_datetime_string_from_system(true, true),
+	}
+	_append_jsonl(directory.path_join("control-results-player-%d.jsonl" % player_number), response)
+	DirAccess.remove_absolute(command_path)
+	print("[modbucksot control] ", response)
+
+func _auto_distribute_items(inter, player, player_number: int) -> void:
+	if !inter.game_state.MAIN_item_grabbing_in_progress or !player.is_grabbing_items:
+		return
+	var manager = player.item_manager
+	if player.is_holding_item_to_place:
+		for slot_index in range(player.user_inventory.size()):
+			if player.user_inventory[slot_index] == {} and slot_index < manager.intbranch_grid_colliders.size() and manager.intbranch_grid_colliders[slot_index].interactionAllowed:
+				manager.PlaceItemRequest(slot_index)
+				print("[modbucksot auto items] player ", player_number, " placed slot ", slot_index + 1)
+				return
+	elif manager.intbranch_intake.interactionAllowed and inter.game_state.GetItemToGrab(player, false) != null:
+		manager.GrabItemRequest()
+		print("[modbucksot auto items] player ", player_number, " requested item")
+
+func _can_pickup(inter, player) -> bool:
+	return player.socket_number == inter.game_state.MAIN_active_current_turn_socket and player.has_turn and player.major_permission_enabled and !player.is_holding_shotgun and inter.intbranch_shotgun.interactionAllowed
+
+func _can_aim(inter, player) -> bool:
+	return player.socket_number == inter.game_state.MAIN_active_current_turn_socket and player.is_holding_shotgun and player.look_manager.checking and player.health_current > 0
+
+func _can_use_item(inter, player) -> bool:
+	return player.socket_number == inter.game_state.MAIN_active_current_turn_socket and player.has_turn and player.major_permission_enabled and !player.is_holding_shotgun and !player.is_interacting_with_item and !player.is_on_secondary_interaction and !player.is_grabbing_items and player.health_current > 0
+
+func _execute(command: Dictionary, inter, player, player_number: int) -> String:
+	if command.get("match_id", "") != SplitMod.telemetry_match_id:
+		return "stale_match"
+	var expected = command.get("expected_event_id", null)
+	if !(expected is int or expected is float) or int(expected) != SplitMod.telemetry_event_id:
+		return "stale_observation"
+	var requested_socket = command.get("player_socket", null)
+	if !(requested_socket is int or requested_socket is float) or int(requested_socket) != player.socket_number:
+		return "wrong_player"
+	if command.get("player_number", -1) != player_number:
+		return "wrong_player"
+	var action = command.get("action", "")
+	if !(action is String):
+		return "invalid_action"
+	if action == "pickup_shotgun":
+		if !_can_pickup(inter, player):
+			return "pickup_not_allowed"
+		player.shotgun.PickupShotgun()
+		return "request_sent"
+	if action == "use_item":
+		if !_can_use_item(inter, player):
+			return "item_phase_not_ready"
+		var slot_value = command.get("item_slot", null)
+		if !(slot_value is int or slot_value is float):
+			return "invalid_item_slot"
+		var slot_index := int(slot_value) - 1
+		if slot_index < 0 or slot_index >= player.user_inventory_instance_array.size() or float(slot_value) != float(slot_index + 1):
+			return "invalid_item_slot"
+		var item = player.user_inventory_instance_array[slot_index]
+		if item == null or item.get_child_count() < 2:
+			return "item_missing"
+		var branch = item.get_child(1)
+		if !branch.interactionAllowed or branch.interactionInvalid:
+			return "item_not_allowed"
+		player.item_interaction.InteractWithItemRequest(item)
+		return "request_sent"
+	if action == "jammer_target":
+		if !player.is_viewing_jammer or !player.is_on_secondary_interaction:
+			return "jammer_choice_not_ready"
+		var socket = _target_socket(command, player)
+		if socket < 0 or socket == player.socket_number:
+			return "invalid_target"
+		var target = player.GetSocketProperties(socket)
+		if target == null or target.health_current <= 0 or target.is_jammed:
+			return "target_unavailable"
+		player.item_interaction.InteractWIthItemRequest_Secondary({"item_id": 3, "item_selected_socket_number": socket})
+		return "request_sent"
+	if action == "steal_item":
+		if !player.is_stealing_item or !player.is_on_secondary_interaction:
+			return "steal_choice_not_ready"
+		var socket = _target_socket(command, player)
+		if socket < 0 or socket == player.socket_number:
+			return "invalid_target"
+		var target = player.GetSocketProperties(socket)
+		if target == null or target.health_current <= 0:
+			return "target_unavailable"
+		var slot_value = command.get("item_slot", null)
+		if !(slot_value is int or slot_value is float):
+			return "invalid_item_slot"
+		var slot_index := int(slot_value) - 1
+		if slot_index < 0 or slot_index >= target.user_inventory_instance_array.size() or float(slot_value) != float(slot_index + 1):
+			return "invalid_item_slot"
+		var item = target.user_inventory_instance_array[slot_index]
+		if item == null or item.get_child_count() < 2:
+			return "item_missing"
+		var branch = item.get_child(1)
+		if branch.item_id == 8 or !branch.interactionAllowed or branch.interactionInvalid:
+			return "item_not_allowed"
+		player.item_interaction.InteractWithItemRequest(item, true)
+		return "request_sent"
+	if action != "aim" and action != "shoot":
+		return "invalid_action"
+	if !_can_aim(inter, player):
+		return "shotgun_not_ready"
+	var target_value = command.get("target_socket", null)
+	if !(target_value is int or target_value is float):
+		return "invalid_target"
+	var target_socket := int(target_value)
+	if target_socket < 0 or target_socket > 3 or float(target_value) != float(target_socket):
+		return "invalid_target"
+	var target = player.GetSocketProperties(target_socket)
+	if target == null or target.health_current <= 0:
+		return "target_unavailable"
+	if action == "aim":
+		var direction: String = player.GetDirection(player.socket_number, target_socket)
+		if direction == "":
+			return "invalid_target"
+		player.look_manager.LookAtDirection(direction)
+		var packet := {
+			"packet category": "MP_PacketVerification",
+			"packet alias": "look at user request",
+			"sent_from": "client",
+			"packet_id": 15,
+			"sent_from_socket": player.socket_number,
+			"direction_to_look": direction,
+		}
+		inter.packets.send_p2p_packet_directly_to_host(SplitMod.sid(player), packet)
+		return "request_sent"
+	if int(aimed_sockets.get(player.socket_number, -1)) != target_socket:
+		return "target_not_aimed"
+	player.shotgun.Shoot(null, target_socket)
+	aimed_sockets.erase(player.socket_number)
+	return "request_sent"
+
+func _target_socket(command: Dictionary, player) -> int:
+	var value = command.get("target_socket", null)
+	if !(value is int or value is float):
+		return -1
+	var socket := int(value)
+	if socket < 0 or socket > 3 or float(value) != float(socket) or player.GetSocketProperties(socket) == null:
+		return -1
+	return socket
+
+func _write_json(path: String, data: Dictionary) -> void:
+	var file := FileAccess.open(path, FileAccess.WRITE)
+	if file == null:
+		return
+	file.store_string(JSON.stringify(data))
+	file.close()
+
+func _append_jsonl(path: String, data: Dictionary) -> void:
+	var mode := FileAccess.READ_WRITE if FileAccess.file_exists(path) else FileAccess.WRITE
+	var file := FileAccess.open(path, mode)
+	if file == null:
+		return
+	file.seek_end()
+	file.store_line(JSON.stringify(data))
+	file.close()
