diff --git a/src/shot_telemetry.gd b/src/shot_telemetry.gd
new file mode 100644
index 0000000..f2db3ac
--- /dev/null
+++ b/src/shot_telemetry.gd
@@ -0,0 +1,30 @@
+
+# Called after ShootingOutcome has applied damage and consumed the shell.
+func TelemetryTargetHealth() -> int:
+	for instance in intermediary.instance_handler.instance_property_array:
+		if instance.socket_number == active_shooter_socket_target:
+			return instance.health_current
+	return -1
+
+func TelemetryShotOutcome(target_health_before: int) -> void:
+	var target_health := -1
+	for instance in intermediary.instance_handler.instance_property_array:
+		if instance.socket_number == active_shooter_socket_target:
+			target_health = instance.health_current
+			break
+	SplitMod.telemetry_write(self, "shot_resolved", {
+		"shooter_socket": active_shooter_socket_self,
+		"target_socket": active_shooter_socket_target,
+		"shell": active_shooter_shell,
+		"damage": active_shooter_shotgun_damage if active_shooter_shell == "live" else 0,
+		"target_health_before": target_health_before,
+		"target_health": target_health,
+		"target_health_zero": target_health == 0,
+	})
+	if target_health_before != target_health:
+		SplitMod.telemetry_write(self, "health_changed", {
+			"socket": active_shooter_socket_target,
+			"before": target_health_before,
+			"after": target_health,
+			"reason": "shot",
+		})
diff --git a/src/telemetry_additions.gd b/src/telemetry_additions.gd
new file mode 100644
index 0000000..47271cc
--- /dev/null
+++ b/src/telemetry_additions.gd
@@ -0,0 +1,9 @@
+
+# Passive host-only telemetry. Appended to MP_RoundManager.gd by tools/build.js.
+
+func TelemetryTurnChanged(previous_socket: int, active_socket: int) -> void:
+	SplitMod.telemetry_write(self, "turn_changed", {
+			"previous_socket": previous_socket,
