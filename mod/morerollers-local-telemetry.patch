 func _init() -> void:
@@ -93,6 +96,8 @@ func _renumber_players() -> void:
 func device_label(device: int) -> String:
 	if device == DEVICE_KBM:
 		return "KEYBOARD & MOUSE"
+	if device <= DEVICE_LOCAL_FIRST:
+		return "KEYBOARD SEAT %d" % -device
 	return "CONTROLLER %d" % (device + 1)
 
 ## Opens the multiplayer lobby scene straight on its match customization screen (see the MP_LobbyUI patch).
@@ -131,6 +136,8 @@ func match_summary() -> Array:
 func start_session() -> void:
 	if active or players.size() < MIN_PLAYERS:
 		return
+	telemetry_event_id = 0
+	telemetry_match_id = str(Time.get_unix_time_from_system()) + "-" + str(get_instance_id())
 	contexts.clear()
 	for i in players.size():
 		var c := Ctx.new()
@@ -257,6 +264,38 @@ func sid(node: Node) -> int:
 	var c := ctx_of(node)
 	return c.user_id if c != null else GlobalSteam.STEAM_ID
 
+func telemetry_write(node: Node, event_type: String, data: Dictionary, visibility: String = "public", recipient_socket: int = -1) -> void:
+	if sid(node) != GlobalSteam.HOST_ID:
+		return
+	if telemetry_match_id == "":
+		telemetry_match_id = str(Time.get_unix_time_from_system()) + "-" + str(get_instance_id())
+	var directory := ProjectSettings.globalize_path("user://modbucksot")
+	var error := DirAccess.make_dir_recursive_absolute(directory)
+	if error != OK:
+		push_warning("Modbucksot telemetry: directory creation failed: " + str(error))
+		return
+	var path := directory.path_join("events.jsonl")
+	var mode := FileAccess.READ_WRITE if FileAccess.file_exists(path) else FileAccess.WRITE
+	var file := FileAccess.open(path, mode)
+	if file == null:
+		push_warning("Modbucksot telemetry: file open failed: " + str(FileAccess.get_open_error()))
+		return
+	telemetry_event_id += 1
+	file.seek_end()
+	var record := {
+		"schema_version": 1,
+		"event_id": telemetry_event_id,
+		"match_id": telemetry_match_id,
+		"timestamp_utc": Time.get_datetime_string_from_system(true, true),
+		"type": event_type,
+		"visibility": visibility,
+		"data": data,
+	}
+	if visibility == "private":
+		record["recipient_socket"] = recipient_socket
+	file.store_line(JSON.stringify(record))
+	file.close()
+
 ## Replaces GlobalVariables for values that belong to one local player.
 func gv(node: Node):
 	var c := ctx_of(node)
