+		"schema_version": 1,
+		"event_id": telemetry_event_id,
+		"match_id": telemetry_match_id,
+		"timestamp_utc": Time.get_datetime_string_from_system(true, true),
+		"type": event_type,
+		"visibility": visibility,
+		"data": data,
+	}
+	if visibility == "private":
+		record["recipient_socket"] = recipient_socket
+	file.store_line(JSON.stringify(record))
+	file.close()
+	telemetry_event.emit(event_type, data)
